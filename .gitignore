*.mrp
*.twr

# Temporary / generated dump files
*.dmp

# Diamond generated temporary VHDL file
._Real_._Math_.vhd

# IMPORTANT:
# Do NOT ignore the following FPGA source/project files:
#
# *.v
# *.sv
# *.vh
# *.vhd
# *.vhdl
# *.ldf
# *.lpf
# *.fdc
# *.ldc
# *.lsdc
# *.sdc
# *.sty
# *.ipx
# *.mem
#
# These are source, constraint, project, strategy or IP files
# and should normally be tracked by Git.


